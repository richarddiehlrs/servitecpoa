# =============================================================================
# ServitecPoa — variáveis de ambiente
# =============================================================================
# Local:  copie para .env.local  →  cp .env.example .env.local
# Vercel: importe vercel-import.env  ou cole estas variáveis no painel
# =============================================================================

# URL pública do site (referência; opcional — o código usa lib/site.ts)
NEXT_PUBLIC_SITE_URL=https://www.servitecpoa.com.br

# Google Search Console — código de verificação HTML (opcional)
# Painel Search Console → Configurações → Verificação → tag HTML
GOOGLE_SITE_VERIFICATION=

# Google Analytics 4
NEXT_PUBLIC_GA_ID=G-4RL0PX0FMN

# Google Ads — conta de anúncios
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18204131668

# Google Ads — rótulo de conversão do clique no WhatsApp
NEXT_PUBLIC_GOOGLE_ADS_WHATSAPP_LABEL=vm9kCNzph8gcENSCtOhD

# Google Meu Negócio — link do perfil (avaliações / rodapé)
NEXT_PUBLIC_GOOGLE_BUSINESS_URL=https://share.google/7zduK7VvJqk64kiGf

# Google Meu Negócio — CID (schema SEO local + link Maps)
# Confirme em: https://www.google.com/maps?cid=10111277396737505345
NEXT_PUBLIC_GOOGLE_BUSINESS_CID=10111277396737505345

# Avaliações do Google — perfil ServitecPoa (5 avaliações, nota 5.0)
NEXT_PUBLIC_GOOGLE_RATING=5
NEXT_PUBLIC_GOOGLE_REVIEW_COUNT=5

# Redes sociais
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/servitec_poa/
